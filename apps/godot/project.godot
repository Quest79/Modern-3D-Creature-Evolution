; Engine configuration file.

config_version=5

[application]

config/name="Modern 3D Creature Evolution"
config/version="0.1.1-test.1"
config/icon="res://icon.svg"
run/main_scene="res://main.tscn"

[debug]

file_logging/enable_file_logging=false

[display]

window/size/viewport_width=1360
window/size/viewport_height=920
window/size/window_width_override=1360
window/size/window_height_override=920
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[environment]

default_clear_color=Color(0.035, 0.04, 0.055, 1)
